    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicLite reads songs from the folders you open or add to the list."
          }
        },
        "pl": {
