      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS może zapytać o każdy z nich w osobnym okienku — kliknij w nim „Używaj MusicLite”. Formaty, które MusicLite już otwiera, pomijam."
